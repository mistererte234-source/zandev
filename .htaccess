# Zandev.id Security Configuration

# Disable Directory Listing (Commented out to prevent 403 if restricted by host)
# Options -Indexes

# Block access to .git specifically instead of all dot files
RedirectMatch 404 /\.git

# HTTP Security Headers
<IfModule mod_headers.c>
    # Prevent Clickjacking
    Header set X-Frame-Options "SAMEORIGIN"

    # Prevent MIME Sniffing
    Header set X-Content-Type-Options "nosniff"

    # Cross-Site Scripting (XSS) Protection
    Header set X-XSS-Protection "1; mode=block"

    # Content Security Policy (Basic)
    Header set Content-Security-Policy "default-src 'self' https: 'unsafe-inline' 'unsafe-eval'; img-src 'self' https: data:; font-src 'self' https: data:; frame-ancestors 'none';"

    # Referrer Policy
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
